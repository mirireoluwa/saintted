# Copy to ".env" in this folder (backend/.env) and adjust.
# cp .env.example .env
#
# Full Supabase + API deploy guide: docs/SUPABASE.md

# --- Supabase Postgres (required for production content) ---
# Dashboard → Project → Connect → URI (replace [YOUR-PASSWORD]).
# Use **direct** (port 5432) for local dev and `manage.py migrate`.
# Use **session pooler** (port 5432 on pooler host) on Render/Fly for the live API.
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Production API host (Render, Fly, Railway, …) ---
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=long-random-string
# DJANGO_ALLOWED_HOSTS=your-api.onrender.com
# CORS_ORIGINS=https://saintted.com,https://www.saintted.com,https://admin.saintted.com,https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=same list as CORS_ORIGINS
#
# Supabase Storage (S3-compatible) — bucket must be **public** for site images:
# USE_S3_MEDIA=1
# SUPABASE_PROJECT_REF=your-project-ref
# S3_BUCKET_NAME=media
# S3_ACCESS_KEY_ID=...          # Project Settings → Storage → S3 access keys
# S3_SECRET_ACCESS_KEY=...
# S3_MEDIA_LOCATION=
# Optional public base for /media/ URLs in API JSON:
# MEDIA_PUBLIC_ORIGIN=https://your-project-ref.supabase.co/storage/v1/object/public/media

# How your name appears on Apple Music / Spotify (cover-art search when art_url is empty)
# COVER_ART_ARTIST=Saintted

# Optional: Spotify API for cover fallback when iTunes has no match
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Resend (transactional email)
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=saintted <noreply@saintted.com>

# Optional emergency admin password reset (required in production for reset endpoint):
# RESET_PASSWORD_SECRET=very-long-random-secret

# Optional tuning
# COVER_ART_CACHE_TTL=86400
# COVER_ART_ITUNES_TIMEOUT=8

# Mailing list → Google Sheets sync (optional).
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
