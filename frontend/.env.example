# Copy to ".env.local" and fill in values.
# cp .env.example .env.local

# Canonical site origin for Open Graph / sitemap (no trailing slash).
VITE_SITE_URL=https://saintted.com

# Optional: comma-separated extra hostnames that load admin routing.
# VITE_ADMIN_HOSTS=admin-staging.vercel.app

# Optional: full origin for the admin subdomain callout link.
# VITE_ADMIN_SITE_URL=https://admin.saintted.com

# Optional: Sentry browser SDK. Leave unset to disable.
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ── Vercel Serverless API (set in Vercel project env vars) ──────────────────

# Admin panel password (the only credential needed — no Django user required).
ADMIN_PASSWORD=change-me-to-a-strong-secret

# Upstash Redis — create a free DB at upstash.com → copy REST URL + token.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Vercel Blob — create a store in Vercel Storage, copy the read-write token.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Resend (transactional email for mailing list).
RESEND_API_KEY=re_...
DEFAULT_FROM_EMAIL=saintted <noreply@saintted.com>
MAILING_LIST_CONFIRMATION_SUBJECT=you're on the list.

# Optional: Google Sheets webhook (legacy — no longer used in serverless version).
# GOOGLE_SHEETS_WEBHOOK_URL=
